<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">

    <!-- A second Flow starts where the first one ended, less than 25pt
         above the foot of the page area. Its paragraph's first line, 26pt
         high, does not fit there, so the paragraph starts on the next page,
         as it would after a block of the same Flow. The rows are 12pt, the
         first Flow's lines 13pt. -->

    <PageFormat width="105mm" height="148mm"/>
    <SetGrid width="5mm" height="12pt"/>
    <StyleSheet>
        p { margin: 0; font-size: 10pt; line-height: 13pt }
        .tall { line-height: 26pt }
    </StyleSheet>
    <Record match="data">
        <Flow>
            <ForAll select="line[@n &lt;= 26]">
                <Paragraph><Value select="concat('First Flow, line ', @n)"/></Paragraph>
            </ForAll>
        </Flow>
        <Flow>
            <Paragraph class="tall" id="second"><Value>The second Flow's paragraph starts on the next page: its first line does not fit in what is left of this one.</Value></Paragraph>
        </Flow>
    </Record>
</Layout>
