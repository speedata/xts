<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">

    <!-- A row taller than the room left on the page, with break-inside: auto:
         it is split where the page ends and its lines run on under the
         repeated TableHead on the next page, both parts with their borders
         and background. Row 3 and the text after the table follow it. -->

    <PageFormat width="105mm" height="148mm"/>
    <SetGrid width="5mm" height="12pt"/>
    <DefineMasterPage name="page" test="true()" margin="10mm"/>
    <StyleSheet>
        table { font-size: 9pt; }
        td { border: 0.5pt solid black; padding: 2pt 3pt; vertical-align: top; }
        thead td { font-weight: bold; background-color: #e0e0e0; }
        td.long { background-color: #f4f4f4; }
    </StyleSheet>

    <Record match="data">
        <PlaceObject>
            <TextBlock><Paragraph><Value>Before the table.</Value></Paragraph></TextBlock>
        </PlaceObject>
        <PlaceObject>
            <Table stretch="max" width="17">
                <TableHead>
                    <Tr><Td><Paragraph><Value>No.</Value></Paragraph></Td><Td><Paragraph><Value>Text</Value></Paragraph></Td></Tr>
                </TableHead>
                <Tr><Td><Paragraph><Value>1</Value></Paragraph></Td><Td><Paragraph><Value>Lorem ipsum.</Value></Paragraph></Td></Tr>
                <Tr style="break-inside: auto">
                    <Td><Paragraph><Value>2</Value></Paragraph></Td>
                    <Td class="long">
                        <ForAll select="p">
                            <Paragraph><Value select="concat(position(), '. ', .)"/></Paragraph>
                        </ForAll>
                    </Td>
                </Tr>
                <Tr><Td><Paragraph><Value>3</Value></Paragraph></Td><Td><Paragraph><Value>Dolor sit amet.</Value></Paragraph></Td></Tr>
            </Table>
        </PlaceObject>
        <PlaceObject>
            <TextBlock><Paragraph><Value>After the table.</Value></Paragraph></TextBlock>
        </PlaceObject>
    </Record>
</Layout>
