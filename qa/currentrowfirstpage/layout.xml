<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">
    <!-- sd:current-row() before anything has created a page sets up the
         page, as sd:current-page() does, and returns its first row. -->
    <Record match="data">
        <SetVariable variable="row" select="sd:current-row()"/>
        <PlaceObject>
            <TextBlock>
                <Paragraph>
                    <Value select="concat('sd:current-row() before the first page: ', $row)"/>
                </Paragraph>
            </TextBlock>
        </PlaceObject>
        <PlaceObject>
            <TextBlock>
                <Paragraph>
                    <Value select="concat('sd:current-row() after the first object: ', sd:current-row())"/>
                </Paragraph>
                <Paragraph>
                    <Value select="."/>
                </Paragraph>
            </TextBlock>
        </PlaceObject>
    </Record>
</Layout>
