<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">

    <!-- A table without a TableHead, taller than the page: the rows are laid
         out down the frame and continued on the next page. The text
         before and after the table checks that the table starts below the
         first block and that the following block lands under the last
         fragment rather than on top of it. -->

