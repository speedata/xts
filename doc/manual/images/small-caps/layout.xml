  <Record match="data">
    <PlaceObject column="8mm" row="4mm">
      <TextBlock width="164mm">
        <Paragraph><Value>Johann Sebastian Bach, Weimar 1708</Value></Paragraph>
        <Paragraph class="sc"><Value>Johann Sebastian Bach, Weimar 1708</Value></Paragraph>
      </TextBlock>
    </PlaceObject>
  </Record>
</Layout>
