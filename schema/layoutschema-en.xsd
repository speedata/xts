        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Selects the child elements from the data XML</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Function">
    <xs:annotation>
      <xs:documentation>Define a function</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:Columns"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>The name of the function (with namespace prefix).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Grid">
    <xs:annotation>
      <xs:documentation>Set the grid of the surrounding Slate. Settings not given here keep the value copied from the page grid. The page grid itself is set with SetGrid.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>The width of a grid cell in the slate.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height">
        <xs:annotation>
          <xs:documentation>The height of a grid cell in the slate.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="nx">
        <xs:annotation>
          <xs:documentation>The number of grid cells of the slate in horizontal direction. It limits the area for the cursor when objects are placed without a column.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="ny">
        <xs:annotation>
          <xs:documentation>The number of grid cells of the slate in vertical direction. It limits the area for the cursor when objects are placed without a row.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dx">
        <xs:annotation>
          <xs:documentation>Gap between two grid cells (horizontal).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dy">
        <xs:annotation>
          <xs:documentation>Gap between two grid cells (vertical).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Slate">
    <xs:annotation>
      <xs:documentation>Create a virtual page (a slate) that behaves like a real page but is not placed into the PDF. Think of it as a magic slate — you draw on it, inspect the result, and then place it on the page.
      The slate starts with a copy of the page grid. With a Grid child element the slate can use its own grid independent of the page.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Grid"></xs:element>
        <xs:element ref="en:Contents"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name of the slate that is created.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SlateContents">
    <xs:annotation>
      <xs:documentation>Insert the contents of a previously created slate.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name of the slate whose contents should be inserted.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="I">
    <xs:annotation>
      <xs:documentation>Switch to italic text.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="Image">
    <xs:annotation>
      <xs:documentation>Includes an external Graphic. Allowed graphic formats are PDF (.pdf), PNG (.png) and JPEG (.jpg). See below for a limitation on the number of included PDF files.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="href" use="required">
        <xs:annotation>
          <xs:documentation>Filename of the image. Can be a file in the search path, an absolute file name, a file-URI for absolute paths (e.g. file:///path/to/image.pdf) or a location on the web (http, https). Use placeholder://WxH (e.g. placeholder://200x150) to generate a placeholder image with the given dimensions in PDF points.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height">
        <xs:annotation>
          <xs:documentation>Image height. One of &#39;auto&#39; (default, take image width), length (such as &#39;3cm&#39;) or number (in grid cells).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="page">
        <xs:annotation>
          <xs:documentation>The page number from the PDF. Default is 1 (include the first page).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="max-width">
        <xs:annotation>
          <xs:documentation>The maximum width of the image. Only used when clip=&#34;no&#34;. Value is a number (grid cells), a length or the value “100%” for full width image.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="max-height">
        <xs:annotation>
          <xs:documentation>The maximum height of the image. Only used when clip=&#34;no&#34;. Value is a number (grid cells) or a length.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="min-width">
        <xs:annotation>
          <xs:documentation>The minimum width of the image. Only used when clip=&#34;no&#34;. Value is a number (grid cells), a length or the value “100%” for full width image.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="min-height">
        <xs:annotation>
          <xs:documentation>The minimum height of the image. Only used when clip=&#34;no&#34;. Value is a number (grid cells) or a length.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="stretch">
        <xs:annotation>
          <xs:documentation>Stretch image until one of maximum width and maximum height is reached. Useful if images should be as large as possible but should not use more than the given space.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="visiblebox">
        <xs:annotation>
          <xs:documentation>The PDF box that represents the visible area of the included image. Default is “cropbox”.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>Image width. One of &#39;auto&#39; (default, take image width), &#39;100%&#39; (whole area width), length (such as &#39;3cm&#39;) or number (in grid cells).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="LoadXML">
    <xs:annotation>
      <xs:documentation>Load an XML file previously written by SaveXML (attribute name) or a well formed XML file (attribute href). The regular data processing is interrupted and the contents of the data file is taken as a data source. If the file does not exist, the call to LoadXML is ignored.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Name of the data file. Example: toc</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Filename of the XML file to load. Example: myfile.xml.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Li">
    <xs:annotation>
      <xs:documentation>List item in an ordered or unordered list.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS class for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS style for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Loop">
    <xs:annotation>
      <xs:documentation>Repeat the contents of this element several times.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>The number of loops. Must be a number or castable as a number.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="variable">
        <xs:annotation>
          <xs:documentation>If given, store the current loop value in this variable. If omitted, the loop value is stored in the variable _loopcounter.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Message">
    <xs:annotation>
      <xs:documentation>Writes a message onto the console and to the protocol file.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:Element"></xs:element>
      </xs:choice>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Contents of the message. You can alternatively specify the message by the child elements Value.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="type">
        <xs:annotation>
          <xs:documentation>The type of the message.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="error"></xs:enumeration>
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="debug"></xs:enumeration>
            <xs:enumeration value="notice"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Layout">
    <xs:annotation>
      <xs:documentation>This command is the root element in the Layout instructions.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:DefineColor"></xs:element>
        <xs:element ref="en:DefineMasterPage"></xs:element>
        <xs:element ref="en:Function"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:Options"></xs:element>
        <xs:element ref="en:PDFOptions"></xs:element>
        <xs:element ref="en:PageFormat"></xs:element>
        <xs:element ref="en:Record"></xs:element>
        <xs:element ref="en:Section"></xs:element>
        <xs:element ref="en:SetGrid"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:StyleSheet"></xs:element>
        <xs:element ref="en:Template"></xs:element>
        <xs:element ref="en:Trace"></xs:element>
        <xs:element ref="en:Layout"></xs:element>
      </xs:choice>
      <xs:attribute name="version">
        <xs:annotation>
          <xs:documentation>Minimum publisher version required. If major or minor version differ, give a warning. Format: 1.6.12 (revision number can be left out).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Mark">
    <xs:annotation>
      <xs:documentation>Sets an invisible mark into the output. This is helpful when you want to know on which page the mark is placed on.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="append">
        <xs:annotation>
          <xs:documentation>When yes, append the current page to the previous values of the mark. Useful to get page ranges in an index. (Default is no.)</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>The name of the mark to be set.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="shiftup">
        <xs:annotation>
          <xs:documentation>Raise the position of the hyperlink anchor by this amount.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="pdftarget">
        <xs:annotation>
          <xs:documentation>Set a pdf target that can be referenced by A</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="NextFrame">
    <xs:annotation>
      <xs:documentation>Switch to the next free frame of a positioning area.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="area" use="required">
        <xs:annotation>
          <xs:documentation>Name of the positioning area.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="NextRow">
    <xs:annotation>
      <xs:documentation>The virtual cursor is set on the next free row.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="area">
        <xs:annotation>
          <xs:documentation>Name of the area of the virtual cursor.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row">
        <xs:annotation>
          <xs:documentation>The absolute number of the row for the cursor. If no row is given, the system tries to find a completely free row (perhaps on an empty page).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="rows">
        <xs:annotation>
          <xs:documentation>The number of rows to clear. Defaults to 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Ol">
    <xs:annotation>
      <xs:documentation>Create an ordered list, just like in HTML</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS class for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS style for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Options">
    <xs:annotation>
      <xs:documentation>Set publisher specific options.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="bleed">
        <xs:annotation>
          <xs:documentation>The amount of bleed. Defaults to 0mm.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="cutmarks">
        <xs:annotation>
          <xs:documentation>Cut marks / crop marks will be placed in the PDF. The distance of the marks from the imaginary center is determined by the attribute trim, but is at least 5mm. The length of the cut marks is 1cm. The default of this attribute is no, that means no cut marks will be displayed.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="features">
        <xs:annotation>
          <xs:documentation>A comma separated list of OpenType features such as +kern,-liga. Used as a default for all paragraphs.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="imagenotfound">
        <xs:annotation>
          <xs:documentation>Controls how a missing image file is reported. In both cases a placeholder image is inserted and the PDF is still produced. With &#34;warning&#34; (default) a warning is logged; with &#34;error&#34; the issue is logged as an error, so the run exits with a non-zero status.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="error"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="missingglyph">
        <xs:annotation>
          <xs:documentation>Controls behavior when a character is not found in the font. With &#34;warning&#34; (default), a warning is logged and the character is skipped. With &#34;error&#34;, the layout run is stopped. With &#34;none&#34;, missing glyphs are silently ignored.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="error"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="mainlanguage">
        <xs:annotation>
          <xs:documentation>The default language for text (hyphenation and rendering). You can also set the default language on the command line and locally set it at Paragraph and TextBlock.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Otherwise">
    <xs:annotation>
      <xs:documentation>Default branch of a Switch command.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="PageFormat">
    <xs:annotation>
      <xs:documentation>The size of the PDF pages. Defaults to 210mm width and 297mm height (A4).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="height" use="required">
        <xs:annotation>
          <xs:documentation>The height of the PDF pages.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" use="required">
        <xs:annotation>
          <xs:documentation>Width of the PDF pages.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Paragraph">
    <xs:annotation>
      <xs:documentation>Insert a paragraph of text. The width of the paragraph is inherited from the surrounding element.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS class for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS style for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Param">
    <xs:annotation>
      <xs:documentation>Specify a parameter for a Function or Template definition, or pass an argument in a CallTemplate.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>The name of the parameter.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>The value of the parameter. On a CallTemplate it is the argument passed to the template; on a Template definition it is the default value used when the caller omits the parameter.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PDFOptions">
    <xs:annotation>
      <xs:documentation>Set PDF options</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="author">
        <xs:annotation>
          <xs:documentation>Set the author of the document</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="creator">
        <xs:annotation>
          <xs:documentation>Set the creator application of the document</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="displaymode">
        <xs:annotation>
          <xs:documentation>Select the display mode when opening PDF document (mainly with Acrobat).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="attachments"></xs:enumeration>
            <xs:enumeration value="bookmarks"></xs:enumeration>
            <xs:enumeration value="fullscreen"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
            <xs:enumeration value="thumbnails"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="duplex">
        <xs:annotation>
          <xs:documentation>Set viewer preference to one or two page printing. Default: empty.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="simplex"></xs:enumeration>
            <xs:enumeration value="duplexflipshortedge"></xs:enumeration>
            <xs:enumeration value="duplexfliplongedge"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="picktraybypdfsize">
        <xs:annotation>
          <xs:documentation>Activate the check box in the PDF viewer for choosing the paper tray based on the page size.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="printscaling">
        <xs:annotation>
          <xs:documentation>Should the printer scale the pages?</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="appdefault"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="showhyperlinks">
        <xs:annotation>
          <xs:documentation>Show hyperlinks in Adobe Acrobat and perhaps other PDF viewers.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="subject">
        <xs:annotation>
          <xs:documentation>Set the subject of the document</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="title">
        <xs:annotation>
          <xs:documentation>Set the title of the document</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PlaceObject">
    <xs:annotation>
      <xs:documentation>Outputs a rectangular object (image, table, box or textblock).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Box"></xs:element>
        <xs:element ref="en:Circle"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:Image"></xs:element>
        <xs:element ref="en:Table"></xs:element>
        <xs:element ref="en:TextBlock"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="allocate">
        <xs:annotation>
          <xs:documentation>Determines if the area of the object is marked as “allocated”. With allocate=&#34;no&#34;, the cursor position is not changed.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="area">
        <xs:annotation>
          <xs:documentation>Name of the positioning area where the object should be placed.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="background">
        <xs:annotation>
          <xs:documentation>Fill the background of the object with a color, given by background-color.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="background-color">
        <xs:annotation>
          <xs:documentation>Color of the background if “background” is set to “yes”.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="column">
        <xs:annotation>
          <xs:documentation>If contents is a number: the grid cell from the left margin of the area. If it is a length: the absolute position from the left paper margin. If this attribute is omitted, the system tries to place the object by itself.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="frame">
        <xs:annotation>
          <xs:documentation>Draw a frame around the object.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>An identifier for this placement. It is attached to the placed object and written to the XML dump (--dumpoutput) as attr-id, so external tools can map the output boxes back to the layout element that produced them. It is not a CSS id: it cannot be matched in stylesheets and does not create a link target.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="slate">
        <xs:annotation>
          <xs:documentation>The name of the slate that gets output. When given, PlaceObject should not contain any objects.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="halign">
        <xs:annotation>
          <xs:documentation>When an object is placed on the grid and it&#39;s width is not a multiple of grid width, there is a space left on the page between the object an the next grid cell. With this attribute you can instruct the software where to place the gap.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="hreference">
        <xs:annotation>
          <xs:documentation>Determines the placement of the object relative to the given column. If &#39;left&#39; (which is the default), the given column is the left border of the object. If &#39;right&#39;, the column determines the right edge of the object.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row">
        <xs:annotation>
          <xs:documentation>The row where the object is placed. If none given, the publisher tries to find a row by itself. You can give a number (in grid cells) or an absolute value (from top left).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="vreference">
        <xs:annotation>
          <xs:documentation>Determines the placement of the object relative to the given row. If &#39;top&#39; (default), the row specifies the top edge. If &#39;bottom&#39;, the row specifies the bottom edge. If &#39;middle&#39;, the row specifies the vertical center.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PositioningArea">
    <xs:annotation>
      <xs:documentation>Describes an area which contains one or more frames. Elements can be placed within these frames.
      The frames can be wrapped in a Switch element. The Switch is evaluated each time a new page is created, so a Case test can use sd:current-page() to select different frames for even and odd pages. If no branch matches, the area does not exist on that page.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:PositioningFrame"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name of the area.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PositioningFrame">
    <xs:annotation>
      <xs:documentation>Defines a rectangular area for objects.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="width" use="required">
        <xs:annotation>
          <xs:documentation>The width of the frame in grid cells.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" use="required">
        <xs:annotation>
          <xs:documentation>The height of the frame in grid cells.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row" use="required">
        <xs:annotation>
          <xs:documentation>The row number relative to the grid.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="column" use="required">
        <xs:annotation>
          <xs:documentation>First column of the frame, in grid cells.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProcessNode">
    <xs:annotation>
      <xs:documentation>Executes all given nodes. The elements, that are to be executed, are given with the attribute selection.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Selection of child elements, that are to be processed.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="mode">
        <xs:annotation>
          <xs:documentation>Name of the mode. This must match the mode at the corresponding Record element. With this it is possible to have different rules for the same element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Record">
    <xs:annotation>
      <xs:documentation>Contains the instructions to be executed when a data element matches the given match expression. The Record matching the root element will be called automatically, all further data handling must be done by the user via ProcessNode. Match expressions support XPath predicates for conditional matching (similar to XSLT template matching).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="match" use="required">
        <xs:annotation>
          <xs:documentation>An XPath match expression. This can be a simple element name (e.g. data) or an element name followed by an XPath predicate in brackets (e.g. item[@type=&#39;invoice&#39;] or item[not(@hidden=&#39;true&#39;)]). When multiple Records match the same element, Records with predicates take priority over those without. Among Records with predicates, the last defined one wins.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="mode">
        <xs:annotation>
          <xs:documentation>Name of the mode that matches the mode in ProcessNode.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SaveXML">
    <xs:annotation>
      <xs:documentation>Saves an element/attribute structure to be used in the next publisher run. The contents must have a tree structure.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Element"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Name of the file. Example: toc.xml</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Name of the file. Example: toc</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="elementname" use="required">
        <xs:annotation>
          <xs:documentation>Name of the root element that surrounds the elements given by the child elements.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Alternative to giving the data structure in the child elements.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="attributes">
        <xs:annotation>
          <xs:documentation>A sequence of attributes (created with Attribute) that is set on the root element. Example: $attributesvar</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Section">
    <xs:annotation>
      <xs:documentation>A structural grouping element for organizing the layout. Has no effect on the output.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:DefineColor"></xs:element>
        <xs:element ref="en:DefineMasterPage"></xs:element>
        <xs:element ref="en:Function"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:Options"></xs:element>
        <xs:element ref="en:PDFOptions"></xs:element>
        <xs:element ref="en:PageFormat"></xs:element>
        <xs:element ref="en:Record"></xs:element>
        <xs:element ref="en:Section"></xs:element>
        <xs:element ref="en:SetGrid"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:StyleSheet"></xs:element>
        <xs:element ref="en:Template"></xs:element>
        <xs:element ref="en:Trace"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name of this section (for documentation purposes only).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SetGrid">
    <xs:annotation>
      <xs:documentation>Set size of the grid cells. All objects are placed in the grid.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>The width of a grid cell. Use either width or nx, not both.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height">
        <xs:annotation>
          <xs:documentation>The height of a grid cell. Use either height or ny, but not both.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="nx">
        <xs:annotation>
          <xs:documentation>Specify the number of grid cells in horizontal direction. Use either nx or width, not both.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="ny">
        <xs:annotation>
          <xs:documentation>Set the number of grid cells in vertical direction. Give ny or height, but not both.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dx">
        <xs:annotation>
          <xs:documentation>Gap between two grid cells (horizontal)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dy">
        <xs:annotation>
          <xs:documentation>Gap between two grid cells (vertical)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Template">
    <xs:annotation>
      <xs:documentation>Define a named template that can be invoked with CallTemplate. Unlike a Function, a template may contain layout actions (such as PlaceObject); they run at the call site, in document order, exactly once.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>The name of the template.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="CallTemplate">
    <xs:annotation>
      <xs:documentation>Invoke a named Template. Parameters are passed with Param children, whose select expressions are evaluated in the calling context. The parameter bindings are scoped to the template body.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>The name of the template to call.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SetVariable">
    <xs:annotation>
      <xs:documentation>Associates a value with a variable name. The value can be a simple value or a more complex one consisting of several elements.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Attribute"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:Columns"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Element"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:Table"></xs:element>
        <xs:element ref="en:TextBlock"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="as">
        <xs:annotation>
          <xs:documentation>A sequence type (in the style of XSLT/XQuery, e.g. element(Column)*, xs:string, node()*) that declares the variable holds a data value. When given, the element body is treated as a data value: layout actions such as PlaceObject are not allowed inside it.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>The value of the contents.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="trace">
        <xs:annotation>
          <xs:documentation>Show information about the assignment in the log file.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="variable" use="required">
        <xs:annotation>
          <xs:documentation>The name of the variable that holds the contents.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Span">
    <xs:annotation>
      <xs:documentation>Surround text by styling options.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS class for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id for this element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>Set the CSS style.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Switch">
    <xs:annotation>
      <xs:documentation>Create an if-then-else construct. The test attribute of each Case commands is evaluated until it yields true. The contents of the Case gets executed. If no test succeeds, the (optional) Otherwise gets executed.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Case"></xs:element>
        <xs:element ref="en:Otherwise"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="StyleSheet">
    <xs:annotation>
      <xs:documentation>Load a CSS file or define CSS rules</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>The filename of the CSS stylesheet including the file extension.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Table">
    <xs:annotation>
      <xs:documentation>Create a table that is similar to the HTML table model.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
