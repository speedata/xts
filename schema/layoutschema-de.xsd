        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Wählt die Kindelemente aus.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Function">
    <xs:annotation>
      <xs:documentation>Definiere eine Funktion</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:Columns"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Der Name der Funktion (mit Namensraum-Präfix)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Slate">
    <xs:annotation>
      <xs:documentation>Erzeugt einen virtuellen Bereich (Slate), in dem Elemente platziert werden können. Wie bei einer Zaubertafel wird der Inhalt zunächst unsichtbar aufgebaut und dann mit PlaceObject auf der Seite platziert.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Contents"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Der Name des anzulegenden Slates.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SlateContents">
    <xs:annotation>
      <xs:documentation>Fügt den Inhalt eines zuvor erstellten Slates ein.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name des Slates, dessen Inhalt eingefügt werden soll.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="I">
    <xs:annotation>
      <xs:documentation>Schaltet auf »Kursiv« um.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="Image">
    <xs:annotation>
      <xs:documentation>Bindet eine externe Grafik ein. Erlaubte Grafikformate sind PDF (.pdf), PNG (.png) und JPEG (.jpg). Siehe unten für die Einschränkung eingebundener PDF-Dateien.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Dateiname des Bildes. Kann entweder eine Datei im Suchpfad sein, ein absoluter Dateiname, ein file-URI-Schema (z.B. file:///pfad/zum/bild.pdf) oder eine Quelle im Web (http/https). Mit placeholder://BxH (z.B. placeholder://200x150) wird ein Platzhalterbild mit den angegebenen Maßen in PDF-Punkten erzeugt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height">
        <xs:annotation>
          <xs:documentation>Bildhöhe. Angabe in der Form &#39;auto&#39; (Voreinstellung, natürliche Bildbreite), Längenangabe wie &#39;4cm&#39; oder Zahl (Anzahl von Rasterspalten)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="page">
        <xs:annotation>
          <xs:documentation>Die Seitenzahl aus dem PDF. Voreinstellung ist 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="maxwidth">
        <xs:annotation>
          <xs:documentation>Die maximale Breite des Bilds. Nur, wenn clip=&#34;no&#34;. Angabe in absoluten Längen, Rasterzellen oder »100%« für volle Breite.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="maxheight">
        <xs:annotation>
          <xs:documentation>Die maximale Breite des Bilds. Nur, wenn clip=&#34;no&#34;. Angabe in absoluten Längen oder Anzahl Rasterzellen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="minwidth">
        <xs:annotation>
          <xs:documentation>Die minimale Breite des Bilds. Nur, wenn clip=&#34;no&#34;. Angabe in absoluten Längen, Rasterzellen oder »100%« für volle Breite.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="minheight">
        <xs:annotation>
          <xs:documentation>Die minimale Breite des Bilds. Nur, wenn clip=&#34;no&#34;. Angabe in absoluten Längen oder Anzahl Rasterzellen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="stretch">
        <xs:annotation>
          <xs:documentation>Dehnt das Bild bis eine der Angaben von maxheight und maxwidth erreich ist. Hilfreich um Bilder so groß wie möglich aber innerhalb gewisser Grenzen anzeigen zu lassen.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="visiblebox">
        <xs:annotation>
          <xs:documentation>Die PDF-Box, die den sichtbaren Bereich angibt des eingebundenen PDFs angibt. Voreinstellung ist »cropbox«.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>Bildbreite. Angabe in der Form &#39;auto&#39; (Voreinstellung, natürliche Bildbreite), &#39;100%&#39; (Breite des aktuellen Platzierungsbereichs), Längenangabe wie &#39;4cm&#39; oder Zahl (Anzahl von Rasterspalten)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="LoadXML">
    <xs:annotation>
      <xs:documentation>Lädt eine Datensatzdatei, die in einem vorherigen Durchlauf des Publishers erzeugt wurde (Attribut name), oder eine reguläre XML-Datei (Attribut href). Die »normale« Verarbeitung des Layoutregelwerks wird unterbrochen und mit dem Inhalt der Datensatzdatei fortgeführt. Nachdem die Verarbeitung der neu geladenen Datensatzdatei beendet ist, wird die Verarbeitung des Layoutregelwerks mit dem ursprünglichen Datensatz fortgesetzt. Eine ausführlichere Erläuterung findet sich im Abschnitt über automatisch generierte Verzeichnisse.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Name der Dateisatzdatei. Beispiel: toc</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Name der XML-Datei, die geladen werden soll. Beispiel: meinedatei.xml.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Li">
    <xs:annotation>
      <xs:documentation>Listeneintrag in einer Aufzählungsliste (mit Aufzählungspunkten oder nummerierten Punkten).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Loop">
    <xs:annotation>
      <xs:documentation>Wiederhole den Inhalt dieses Elements mehrfach.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Die Anzahl der Schleifendurchläufe. Muss eine Zahl oder in eine Zahl konvertierbar sein.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="variable">
        <xs:annotation>
          <xs:documentation>Wenn angegeben, wird die Nummer des Schleifendurchlaufs in dieser Variablen gespeichert, ansonsten in _loopcounter.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Message">
    <xs:annotation>
      <xs:documentation>Gibt eine Textmeldung auf der Konsole und in der Protokolldatei aus.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:Element"></xs:element>
      </xs:choice>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Inhalt der Nachricht. Alternativ dazu: Kindelemente Wert innerhalb des Elements »Message«</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="type">
        <xs:annotation>
          <xs:documentation>Der Typ der Nachricht.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="error"></xs:enumeration>
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="debug"></xs:enumeration>
            <xs:enumeration value="notice"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Layout">
    <xs:annotation>
      <xs:documentation>Das Layout-Element ist das Wurzelelement im Layoutregelwerk.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:DefineColor"></xs:element>
        <xs:element ref="en:DefineMasterPage"></xs:element>
        <xs:element ref="en:Function"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:Options"></xs:element>
        <xs:element ref="en:PDFOptions"></xs:element>
        <xs:element ref="en:PageFormat"></xs:element>
        <xs:element ref="en:Record"></xs:element>
        <xs:element ref="en:Section"></xs:element>
        <xs:element ref="en:SetGrid"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:StyleSheet"></xs:element>
        <xs:element ref="en:Template"></xs:element>
        <xs:element ref="en:Trace"></xs:element>
        <xs:element ref="en:Layout"></xs:element>
      </xs:choice>
      <xs:attribute name="version">
        <xs:annotation>
          <xs:documentation>Gibt die minimale Version des Publishers an. Format: 1.6.13. Die letzten Ziffern können weggelassen werden. Falls die erste oder die zweite Ziffer der Versionsangabe unterschiedlich ist, wird eine Warnung ausgegeben.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Mark">
    <xs:annotation>
      <xs:documentation>Setzt eine unsichtbare Markierung in die Ausgabe. Das ist hilfreich, um die Seitenzahl zu bestimmen, auf der die Marke gelandet ist.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="append">
        <xs:annotation>
          <xs:documentation>Wenn &#39;yes&#39;, dann wird die aktuelle Seitenzahl an den letzten Wert angehängt (mit Komma separiert). Nützlich, um Seitenzahlen wie S. 3-5 im Index zu erstellen. Voreinstellung ist nein.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Der Name des Markers, der gesetzt wird.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="shiftup">
        <xs:annotation>
          <xs:documentation>Verschiebe die Position des Hyperlink-Ankers um diesen Betrag.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="pdftarget">
        <xs:annotation>
          <xs:documentation>Setze ein PDF-Ziel, das mit A referenziert werden kann.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="NextFrame">
    <xs:annotation>
      <xs:documentation>Schaltet auf den nächsten freien Rahmen eines Platzierungsbereichs um.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="area" use="required">
        <xs:annotation>
          <xs:documentation>Name des Platzierungsbereich, in dem der nächste Rahmen gesucht werden soll.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="NextRow">
    <xs:annotation>
      <xs:documentation>Der virtuelle Cursor wird auf die nächste freie Zeile gesetzt.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="area">
        <xs:annotation>
          <xs:documentation>Name des Bereichs, in dem der Cursor bewegt wird.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row">
        <xs:annotation>
          <xs:documentation>Zeile für den virtuellen Cursor. Wird keine Zeile angegeben, dann sucht sich der Publisher selbständig eine freie Zeile (ggf. auf einer neuen Seite oder in einem neuen Platzierungsrahmen).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="rows">
        <xs:annotation>
          <xs:documentation>Anzahl der Zeilen, die frei gehalten werden sollen. Vorgabe: 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Ol">
    <xs:annotation>
      <xs:documentation>Erzeugt eine nummerierte Aufzählungsliste wie in HTML</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Options">
    <xs:annotation>
      <xs:documentation>Setzt Publisher-spezifische Optionen.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="bleed">
        <xs:annotation>
          <xs:documentation>Die Größe des Anschnitts (bleed). Voreinstellung ist 0mm.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="cutmarks">
        <xs:annotation>
          <xs:documentation>Beschnittmarken (crop marks) werden ausgegeben. Der Abstand der Schnittmarken vom gedachten Mittelpunkt ergibt sich durch die Beschnittzugabe, mindestens beträgt sie jedoch 5pt. Die Länge der Schnittmarke ist 1cm. Voreinstellung ist nein, d.h. es werden keine Schnittmarken ausgegeben.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="features">
        <xs:annotation>
          <xs:documentation>Eine kommaseparierte Liste mit OpenType Features wie +kern,-liga. Wird als Voreinstellung für alle Absätze benutzt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="imagenotfound">
        <xs:annotation>
          <xs:documentation>Steuert, wie eine nicht gefundene Bilddatei gemeldet wird. In beiden Fällen wird ein Platzhalterbild eingefügt und das PDF dennoch erzeugt. Bei &#34;warning&#34; (Voreinstellung) wird eine Warnung ausgegeben; bei &#34;error&#34; wird der Fehler protokolliert, sodass der Lauf mit einem Exit-Status ungleich null endet.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="error"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="missingglyph">
        <xs:annotation>
          <xs:documentation>Steuert das Verhalten bei Zeichen, die nicht im Zeichensatz vorhanden sind. Bei &#34;warning&#34; (Voreinstellung) wird eine Warnung ausgegeben und das Zeichen übersprungen. Bei &#34;error&#34; wird der Layoutlauf abgebrochen. Bei &#34;none&#34; werden fehlende Zeichen stillschweigend ignoriert.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="warning"></xs:enumeration>
            <xs:enumeration value="error"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="mainlanguage">
        <xs:annotation>
          <xs:documentation>Die Sprache (Silbentrennung und Darstellung), die im Text benutzt wird, wenn keine andere Sprache angegeben ist. Sie kann global über die Kommandozeile gesteuert werden oder für jeden Paragraph und TextBlock einzeln.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Otherwise">
    <xs:annotation>
      <xs:documentation>Zweig, der bei Switch ausgeführt wird, wenn kein Case wahr ist.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="PageFormat">
    <xs:annotation>
      <xs:documentation>Legt die Größe des Ausgabemediums (z.B. DIN A4) fest. Voreinstellung ist eine Breite von 210mm und eine Höhe von 297mm.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="height" use="required">
        <xs:annotation>
          <xs:documentation>Höhe des Ausgabemediums.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="width" use="required">
        <xs:annotation>
          <xs:documentation>Breite des Ausgabemediums.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Paragraph">
    <xs:annotation>
      <xs:documentation>Erzeugt einen Absatz innerhalb eines TextBlocks.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil-Angaben für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Param">
    <xs:annotation>
      <xs:documentation>Lege einen Parameter für eine Function- oder Template-Definition fest oder übergebe ein Argument bei CallTemplate.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Der Name des Parameters</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Der Wert des Parameters. Bei CallTemplate ist es das an das Template übergebene Argument; bei einer Template-Definition der Vorgabewert, falls der Aufrufer den Parameter weglässt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PDFOptions">
    <xs:annotation>
      <xs:documentation>Setze PDF Optionen</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="author">
        <xs:annotation>
          <xs:documentation>Legt den Autor des Dokuments fest</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="creator">
        <xs:annotation>
          <xs:documentation>Legt die Anwendung des Dokuments fest</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="displaymode">
        <xs:annotation>
          <xs:documentation>Wähle den PDF-Anzeigemodes (vornehmlich beim Adobe Acrobat).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="attachments"></xs:enumeration>
            <xs:enumeration value="bookmarks"></xs:enumeration>
            <xs:enumeration value="fullscreen"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
            <xs:enumeration value="thumbnails"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="duplex">
        <xs:annotation>
          <xs:documentation>Setze PDF Anzeigeprogramm auf einseitigen oder doppelseitigen Druck. Voreinstellung: leer.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="simplex"></xs:enumeration>
            <xs:enumeration value="duplexflipshortedge"></xs:enumeration>
            <xs:enumeration value="duplexfliplongedge"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="picktraybypdfsize">
        <xs:annotation>
          <xs:documentation>Auswahlfeld im PDF-Viewer »Papierquelle gemäß PDF-Seitengröße auswählen«.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="printscaling">
        <xs:annotation>
          <xs:documentation>Soll der Drucker die Seiten skalieren?</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="appdefault"></xs:enumeration>
            <xs:enumeration value="none"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="showhyperlinks">
        <xs:annotation>
          <xs:documentation>Zeige Hyperlinks im Adobe Acrobat und ggf anderen PDF-Anzeigeprogrammen.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="subject">
        <xs:annotation>
          <xs:documentation>Legt den Betreff (subject) des Dokuments fest</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="title">
        <xs:annotation>
          <xs:documentation>Legt den Titel des Dokuments fest</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PlaceObject">
    <xs:annotation>
      <xs:documentation>Gibt ein rechteckiges Objekt (Bild, Tabelle, Box oder TextBlock) aus.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Box"></xs:element>
        <xs:element ref="en:Circle"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:Image"></xs:element>
        <xs:element ref="en:Table"></xs:element>
        <xs:element ref="en:TextBlock"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="allocate">
        <xs:annotation>
          <xs:documentation>Bestimmt, ob im Raster der Platz für das Objekt als »belegt« markiert wird. Bei allocate=&#34;no&#34; wird auch die aktuelle Zeile im Raster nicht verändert.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="area">
        <xs:annotation>
          <xs:documentation>Name des Platzierungsbereich, in dem das Objekt ausgegeben werden soll.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="background">
        <xs:annotation>
          <xs:documentation>Erzeugt einen farbigen Hintergrund für das Objekt. Das Attribut »backgroundcolor« gibt die Farbe an.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="backgroundcolor">
        <xs:annotation>
          <xs:documentation>Hintergrundfarbe wenn das Objekt mit einer Farbe hinterlegt werden soll.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="column">
        <xs:annotation>
          <xs:documentation>Zahl: Die Spalte im Raster, in der das Objekt ausgegeben wird. Wird die Spalte nicht angegeben, so sucht sich das System selbständig eine passende freie Zeile für das Objekt. Maßangabe: die Position von der linken Blattkante.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="frame">
        <xs:annotation>
          <xs:documentation>Es wird ein Rahmen um das Objekt gezeichnet.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>Ein Bezeichner für diese Platzierung. Er wird dem platzierten Objekt mitgegeben und als attr-id in die XML-Ausgabe (--dumpoutput) geschrieben, damit externe Werkzeuge die ausgegebenen Boxen dem erzeugenden Layoutelement zuordnen können. Es ist keine CSS-id: er kann nicht in Stylesheets angesprochen werden und erzeugt kein Verweisziel.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="slate">
        <xs:annotation>
          <xs:documentation>Wenn ein Slate ausgegeben werden soll, muss der Name hier angegeben werden.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="halign">
        <xs:annotation>
          <xs:documentation>Wird ein Objekt ausgegeben, das kein vielfaches der Rasterbreite ist, dann gibt das Attribut die horizontale Ausrichtung an. ›left‹ beispielsweise bedeutet, dass der freie Platz rechts des Objekts bleibt. Voreinstellung ist ›left‹.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="hreference">
        <xs:annotation>
          <xs:documentation>Bestimmt, ob die angegebene Spalte die linke oder die rechte Kante vom Objekt bezeichnet.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row">
        <xs:annotation>
          <xs:documentation>Zahl: Die Zeile im Raster, in der das Objekt ausgegeben wird. Wird die Zeile nicht angegeben, so sucht sich das System selbständig eine passende freie Zeile für das Objekt. Maßangabe: die Position von der oberen Blattkante.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="vreference">
        <xs:annotation>
          <xs:documentation>Bestimmt, ob die angegebene Zeile die obere, untere oder mittlere Kante des Objekts bezeichnet.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PositioningArea">
    <xs:annotation>
      <xs:documentation>Beschreibt einen Platzierungsbereich, der mehrere Platzierungsrahmen beinhalten kann. In diesen Rahmen können Elemente platziert werden</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:PositioningFrame"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name des Platzierungsbereichs</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="PositioningFrame">
    <xs:annotation>
      <xs:documentation>Beschreibt einen rechteckigen Bereich, in dem Elemente platziert werden können. Inhalte in diesen Bereichen werden bei Platzmangel automatisch in den nächsten Rahmen desselben Bereichs platziert.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="width" use="required">
        <xs:annotation>
          <xs:documentation>Breite des Rahmens in Rasterkästen</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height" use="required">
        <xs:annotation>
          <xs:documentation>Höhe des Rahmens in Rasterkästen</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="row" use="required">
        <xs:annotation>
          <xs:documentation>Erste Zeile des Rahmens</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="column" use="required">
        <xs:annotation>
          <xs:documentation>Erste Spalte des Rahmens</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProcessNode">
    <xs:annotation>
      <xs:documentation>Bearbeitet alle angegebenen Datensätze. Die Elemente, für die die Regeln ausgeführt werden sollen, werden mit dem Attribut select angegeben.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="select" use="required">
        <xs:annotation>
          <xs:documentation>Auswahl der Kindelemente, die verarbeitet werden sollen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="mode">
        <xs:annotation>
          <xs:documentation>Name des Modus. Dieser muss bei Record exakt übereinstimmen. Damit ist es möglich für dasselbe Element unterschiedliche Regeln aufzurufen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Record">
    <xs:annotation>
      <xs:documentation>Enthält die Anweisungen, die ausgeführt werden, wenn ein Datenelement dem angegebenen Match-Ausdruck entspricht. Der Record, der auf das Wurzelelement passt, wird automatisch aufgerufen; alle weiteren Datensätze müssen über ProcessNode verarbeitet werden. Match-Ausdrücke unterstützen XPath-Prädikate für bedingtes Matching (ähnlich wie XSLT-Template-Matching).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="match" use="required">
        <xs:annotation>
          <xs:documentation>Ein XPath-Match-Ausdruck. Dies kann ein einfacher Elementname sein (z.B. data) oder ein Elementname gefolgt von einem XPath-Prädikat in eckigen Klammern (z.B. item[@type=&#39;invoice&#39;] oder item[not(@hidden=&#39;true&#39;)]). Wenn mehrere Records auf dasselbe Element passen, haben Records mit Prädikaten Vorrang vor solchen ohne. Bei mehreren passenden Records mit Prädikaten gewinnt der zuletzt definierte.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="mode">
        <xs:annotation>
          <xs:documentation>Name des Modus der mit dem in ProcessNode übereinstimmt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SaveXML">
    <xs:annotation>
      <xs:documentation>Speichert eine XML-Datei auf Festplatte. Diese Datei muss als Kindelement hierarchische Struktur, zum Beispiel aus den Befehlen Element und Attribut enthalten, wahlweise zusammengesetzt durch Variablen. Eine ausführlichere Erläuterung findet sich im Abschnitt über automatisch generierte Verzeichnisse.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Element"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Name der Dateisatzdatei. Beispiel: toc.xml</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="name">
        <xs:annotation>
          <xs:documentation>Name der Dateisatzdatei. Beispiel: toc</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="elementname" use="required">
        <xs:annotation>
          <xs:documentation>Name des Wurzelelements, das erzeugt wird.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Alternativ zur Angabe des Datensatzes im Kindelement.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Section">
    <xs:annotation>
      <xs:documentation>Ein Gliederungselement zur Organisation des Layouts. Hat keinen Einfluss auf die Ausgabe.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:DefineColor"></xs:element>
        <xs:element ref="en:DefineMasterPage"></xs:element>
        <xs:element ref="en:Function"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:Options"></xs:element>
        <xs:element ref="en:PDFOptions"></xs:element>
        <xs:element ref="en:PageFormat"></xs:element>
        <xs:element ref="en:Record"></xs:element>
        <xs:element ref="en:Section"></xs:element>
        <xs:element ref="en:SetGrid"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:StyleSheet"></xs:element>
        <xs:element ref="en:Template"></xs:element>
        <xs:element ref="en:Trace"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Name dieses Abschnitts (nur zur Dokumentation).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SetGrid">
    <xs:annotation>
      <xs:documentation>Setzt die Größe und Höhe eines Rasterkästchens. In dem Seitenraster können Elemente platziert werden.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>Breite einer Rasterzelle. Entweder width oder nx benutzen, nicht beide.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="height">
        <xs:annotation>
          <xs:documentation>Höhe einer Rasterzelle. Entweder höhe oder ny angeben, nicht beide.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="nx">
        <xs:annotation>
          <xs:documentation>Anzahl der Rasterzellen in horizontaler Richtung. Entweder nx oder width angeben.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="ny">
        <xs:annotation>
          <xs:documentation>Gibt die Anzahl der Rasterzellen in vertikaler Richtung an. Entweder ny oder höhe angeben.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dx">
        <xs:annotation>
          <xs:documentation>Abstand zwischen zwei Rasterzellen (horizontal)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="dy">
        <xs:annotation>
          <xs:documentation>Abstand zwischen zwei Rasterzellen (horizontal)</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Template">
    <xs:annotation>
      <xs:documentation>Definiert ein benanntes Template, das mit CallTemplate aufgerufen werden kann. Anders als eine Function darf ein Template Layout-Aktionen (etwa PlaceObject) enthalten; diese laufen an der Aufrufstelle, in Dokumentreihenfolge, genau einmal.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
        <xs:element ref="en:AttachFile"></xs:element>
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Slate"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Der Name des Templates.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="CallTemplate">
    <xs:annotation>
      <xs:documentation>Ruft ein benanntes Template auf. Parameter werden über Param-Kindelemente übergeben, deren select-Ausdrücke im Aufruferkontext ausgewertet werden. Die Parameterbindungen gelten nur im Rumpf des Templates.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Param"></xs:element>
      </xs:choice>
      <xs:attribute name="name" use="required">
        <xs:annotation>
          <xs:documentation>Der Name des aufzurufenden Templates.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="SetVariable">
    <xs:annotation>
      <xs:documentation>Weist einer Variablen einen Wert zu. Der Wert kann aus mehreren Elementen bestehen (siehe zweites Beispiel).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:Columns"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Element"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:Table"></xs:element>
        <xs:element ref="en:TextBlock"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="as">
        <xs:annotation>
          <xs:documentation>Ein Sequenztyp (im Stil von XSLT/XQuery, z. B. element(Column)*, xs:string, node()*), der angibt, dass die Variable einen Datenwert enthält. Wenn angegeben, wird der Inhalt des Elements als Datenwert behandelt: Layout-Aktionen wie PlaceObject sind darin nicht erlaubt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Inhalt, der der Variablen zugewiesen wird.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="trace">
        <xs:annotation>
          <xs:documentation>Zeige Informationen über die Zuweisung in der Logdatei.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="variable" use="required">
        <xs:annotation>
          <xs:documentation>Name der Variablen, der etwas zugewiesen werden soll.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Span">
    <xs:annotation>
      <xs:documentation>Text mit Style-Optionen umgeben.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>Setze den CSS-Stil.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Switch">
    <xs:annotation>
      <xs:documentation>Erzeugt eine „Wenn-Dann-Abfrage“. Das heißt, für jedes Kindelement Case wird überprüft, ob die Bedingung erfüllt ist. Wenn ja, dann wird der Inhalt des Kindelements Case ausgeführt und die Verarbeitung hinter der Fallunterscheidung fortgesetzt. Wenn keine Bedingung erfüllt wurde und ein Element Otherwise gefunden wurde, wird der         Inhalt des Elements Otherwise ausgeführt. Durch das frühzeitige Abbrechen werden nachfolgende Fälle nicht weiter untersucht (siehe Beispiel).</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Case"></xs:element>
        <xs:element ref="en:Otherwise"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="StyleSheet">
    <xs:annotation>
      <xs:documentation>Lädt eine CSS-Datei oder definiert CSS-Eigenschaften</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:attribute name="href">
        <xs:annotation>
          <xs:documentation>Der Dateiname der CSS Datei (inklusive Dateiendung).</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Table">
    <xs:annotation>
      <xs:documentation>Erzeugt eine Tabelle, die in etwa dem HTML Tabellenmodell entspricht.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Columns"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:TableHead"></xs:element>
        <xs:element ref="en:TableRule"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>Der Bereich, den die Tabelle (maximal) im Raster belegt. Angabe in Rasterzellen oder absoluten Längenangaben. Voreinstellung ist der verfügbare Platz.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="stretch">
        <xs:annotation>
          <xs:documentation>Wenn auf &#34;max&#34; gesetzt, wird die Tabelle auf die volle Breite gedehnt (entspricht CSS width: 100%).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="max"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="TableHead">
    <xs:annotation>
      <xs:documentation>Gibt den Tabellenkopf an.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:TableRule"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="TableRule">
    <xs:annotation>
      <xs:documentation>Zeichnet eine horizontale Linie über die gesamte Tabellenbreite. Standarddicke ist 0,4 Punkt.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="rulewidth">
        <xs:annotation>
          <xs:documentation>Dicke der Linie. Voreinstellung ist 0,4 Punkt.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="color">
        <xs:annotation>
          <xs:documentation>Farbe der Linie. Mit »transparent« wird nur Platz reserviert. Voreinstellung ist schwarz.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS-Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS-ID für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS-Style für dieses Element. Überschreibt die Attribute rulewidth und color.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Td">
    <xs:annotation>
      <xs:documentation>Erstellt eine Tabellenzelle, wie in HTML</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Bookmark"></xs:element>
        <xs:element ref="en:Box"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:SlateContents"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:Image"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Table"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>Die CSS-Klasse für die Formtierung.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für diese Tabellenzelle.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für diese Tabellenzelle.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="colspan">
        <xs:annotation>
          <xs:documentation>Die Anzahl der Spalten, die die Zelle überdecken soll. Voreinstellung ist 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="rowspan">
        <xs:annotation>
          <xs:documentation>Die Anzahl der Zeilen, die die Zelle überdecken soll. Voreinstellung ist 1.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="TextBlock">
    <xs:annotation>
      <xs:documentation>Erzeugt einen rechteckigen Bereich mit Text.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Bookmark"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
      </xs:choice>
      <xs:attribute name="parsep">
        <xs:annotation>
          <xs:documentation>Der vertikale Abstand zwischen zwei Absätzen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="width">
        <xs:annotation>
          <xs:documentation>Anzahl der Spalten, die der Text einnehmen soll. Wenn das Attribut nicht angegeben wird, so bestimmt das umliegende Element die Breite.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Tr">
    <xs:annotation>
      <xs:documentation>Erstellt eine Tabellenzeile</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Trace">
    <xs:annotation>
      <xs:documentation>Setze Debugging-Schalter</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attribute name="dests">
        <xs:annotation>
          <xs:documentation>Zeige PDF Ziele mit einem schwarzen Kreis.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="grid">
        <xs:annotation>
          <xs:documentation>Wenn &#39;yes&#39;, dann zeichnet der Publisher das zugrunde liegende Raster auf die Seiten.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="gridallocation">
        <xs:annotation>
          <xs:documentation>Wenn &#39;yes&#39;, dann markiert der Publisher die belegten Rasterzellen mit einer Hintergrundfarbe.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="hyperlinks">
        <xs:annotation>
          <xs:documentation>Wenn &#39;yes&#39;, dann zeichnet XTS einen Rahmen um die Hyperlinks.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="hyphenation">
        <xs:annotation>
          <xs:documentation>Bei &#39;yes&#39; markiert der speedata Publisher die möglichen Trennstellen für die Silbentrennung.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="objects">
        <xs:annotation>
          <xs:documentation>Zeichnet Kästchen um Objekte.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Ul">
    <xs:annotation>
      <xs:documentation>Erzeugt eine Stichpunktliste mit Aufzählungspunkten</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="U">
    <xs:annotation>
      <xs:documentation>Unterstreiche Text.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:A"></xs:element>
        <xs:element ref="en:Action"></xs:element>
        <xs:element ref="en:B"></xs:element>
        <xs:element ref="en:Br"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:I"></xs:element>
        <xs:element ref="en:Ol"></xs:element>
        <xs:element ref="en:U"></xs:element>
        <xs:element ref="en:Ul"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:CopyOf"></xs:element>
        <xs:element ref="en:Span"></xs:element>
      </xs:choice>
      <xs:attribute name="class">
        <xs:annotation>
          <xs:documentation>CSS Klasse für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="id">
        <xs:annotation>
          <xs:documentation>CSS id für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="style">
        <xs:annotation>
          <xs:documentation>CSS Stil für dieses Element.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Until">
    <xs:annotation>
      <xs:documentation>Erzeugt eine Schleife. Die Kindelemente werden so oft ausgeführt, bis die Bedingung im Attribut »wahr« ergibt. Der Rückgabewert von Until ist der aneinandergekettete Rückgabewert aller Kindelemente.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="test" use="required">
        <xs:annotation>
          <xs:documentation>Nach jedem Schleifendurchlauf wird die Bedingung überprüft. Wenn sie »wahr« ergibt, wird die Schleife verlassen.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="HTML">
    <xs:annotation>
      <xs:documentation>Fügt HTML-Inhalt ein, entweder inline oder per XPath-Ausdruck ermittelt.</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"></xs:any>
      </xs:sequence>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>XPath-Ausdruck, der ein XML/HTML-Fragment liefert.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="expand-text">
        <xs:annotation>
          <xs:documentation>Bei &#34;yes&#34; werden Ausdrücke in geschweiften Klammern {expr} im HTML-Inhalt als XPath-Ausdrücke ausgewertet (ähnlich wie XSLT 3.0 Text Value Templates). Für literale geschweifte Klammern {{ und }} verwenden. Standard ist &#34;no&#34;.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="yes"></xs:enumeration>
            <xs:enumeration value="no"></xs:enumeration>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Value">
    <xs:annotation>
      <xs:documentation>Beinhaltet einen Textinhalt, der an das umgebende Element übergeben wird (immer als reiner Text).</xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"></xs:any>
      </xs:sequence>
      <xs:attribute name="select">
        <xs:annotation>
          <xs:documentation>Wert, der zum umgebenden Element übergeben wird.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="While">
    <xs:annotation>
      <xs:documentation>Erzeugt eine Schleife, die wiederholt durchlaufen wird. Die Kindelemente werden so oft ausgeführt, solange die Bedingung im Attribut »wahr« ergibt.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="en:CallTemplate"></xs:element>
        <xs:element ref="en:Column"></xs:element>
        <xs:element ref="en:ClearPage"></xs:element>
        <xs:element ref="en:ForAll"></xs:element>
        <xs:element ref="en:HTML"></xs:element>
        <xs:element ref="en:LoadXML"></xs:element>
        <xs:element ref="en:Loop"></xs:element>
        <xs:element ref="en:Li"></xs:element>
        <xs:element ref="en:Message"></xs:element>
        <xs:element ref="en:NextFrame"></xs:element>
        <xs:element ref="en:NextRow"></xs:element>
        <xs:element ref="en:Paragraph"></xs:element>
        <xs:element ref="en:PlaceObject"></xs:element>
        <xs:element ref="en:ProcessNode"></xs:element>
        <xs:element ref="en:SaveXML"></xs:element>
        <xs:element ref="en:SetVariable"></xs:element>
        <xs:element ref="en:Switch"></xs:element>
        <xs:element ref="en:Td"></xs:element>
        <xs:element ref="en:Tr"></xs:element>
        <xs:element ref="en:Until"></xs:element>
        <xs:element ref="en:Value"></xs:element>
        <xs:element ref="en:While"></xs:element>
      </xs:choice>
      <xs:attribute name="test" use="required">
        <xs:annotation>
          <xs:documentation>Für jedes Mal, das die Schleife durchlaufen werden soll, muss die Bedingung im Attribut erfüllt sein. Die Bedingung wird am Anfang der Schleife überprüft. Eine Schleife, bei der die Bedingung am Ende der Schleife geprüft wird, ist Until.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
